{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",             // 👈 siempre desde raíz del proyecto web
    "jsx": "preserve",
    "paths": {
      "@hooks/*": ["hooks/*"],                        // ✅ hooks está al lado de src/
      "@lib/*": ["src/lib/*"],                        // ✅ supabase-web.ts
      "@utils/*": ["../../packages/utils/*"],         // ✅ backcase
      "@shared/*": ["../../packages/utils/*"],        // alias opcional
      "@components/*": ["src/components/*"],
      "@styles/*": ["src/styles/*"],
      "@admin/*": ["src/app/admin/*"]
    },
    "plugins": [{ "name": "next" }],
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
// Nota: Este tsconfig.json es específico para el proyecto web y no debe ser usado en otros proyectos
// Nota: Asegúrate de que los paths sean correctos según la estructura de tu proyecto
// Nota: Este archivo es para un proyecto Next.js, por lo que incluye configuraciones específicas para Next.js
// Nota: Si usas TypeScript en otros proyectos, necesitarás crear tsconfig.json específicos para cada uno
